# Copy this file to ".env" and fill in the values. Never commit ".env".

# --- Local development (your own computer) ---
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only when you test through ngrok, add the ngrok host to the line above and the
# full https address here, for example:
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-name.ngrok-free.dev
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://your-name.ngrok-free.dev
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PythonAnywhere (free tier) - put these in the ".env" on the server ---
# DJANGO_SECRET_KEY=<a new long random value, see DEPLOY_PYTHONANYWHERE.md>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
# DJANGO_MAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Email is not used by the shop. Leave the console backend unless you add email.
DJANGO_MAIL_BACKEND=django.core.mail.backends.console.EmailBackend
